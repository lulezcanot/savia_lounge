---
import PlusIcon from "@phosphor-icons/core/assets/regular/plus.svg";
import Pendiente from "./Pendiente.astro";
import { preguntas } from "../data/site";
---

<section id="preguntas" aria-labelledby="preguntas-titulo" class="bg-lino px-4 py-24 md:px-16">
  <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[1fr_2fr]">
    <header data-reveal class="flex flex-col gap-4">
      <p class="caption-3 text-musgo">Preguntas frecuentes</p>
      <h2 id="preguntas-titulo" class="heading-2 text-tinta">Antes de venir</h2>
    </header>

    <div class="flex flex-col">
      {
        preguntas.map((p) => (
          <details data-reveal class="group border-b border-tinta/15">
            <summary class="title-2 flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-tinta [&::-webkit-details-marker]:hidden">
              <span>{p.pregunta}</span>
              <PlusIcon
                class="size-5 shrink-0 text-musgo transition-transform duration-500 ease-savia group-open:rotate-45"
                aria-hidden="true"
              />
            </summary>
            <div class="flex flex-col gap-3 pb-6">
              {p.respuesta && <p class="body-3 max-w-170 text-tinta-suave">{p.respuesta}</p>}
              {p.pendiente && <Pendiente class="text-tinta-suave" texto={p.pendiente} />}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
