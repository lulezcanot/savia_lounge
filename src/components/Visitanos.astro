---
import { Picture } from "astro:assets";
import MapPinIcon from "@phosphor-icons/core/assets/regular/map-pin.svg";
import ClockIcon from "@phosphor-icons/core/assets/regular/clock.svg";
import WhatsappIcon from "@phosphor-icons/core/assets/regular/whatsapp-logo.svg";
import InstagramIcon from "@phosphor-icons/core/assets/regular/instagram-logo.svg";
import BotonReservar from "./BotonReservar.astro";
import { negocio } from "../data/site";
import clienta from "../assets/photos/clienta-letrero.jpg";

const datos = [
  { icono: MapPinIcon, titulo: "Dirección", texto: `${negocio.direccion}, ${negocio.zona}, ${negocio.ciudad}` },
  { icono: ClockIcon, titulo: "Horario", texto: negocio.horario },
  { icono: WhatsappIcon, titulo: "WhatsApp", texto: negocio.whatsappVisible },
  { icono: InstagramIcon, titulo: "Instagram", texto: negocio.instagramUsuario },
];
---

<section id="visitanos" aria-labelledby="visitanos-titulo" class="bg-bosque px-4 py-24 text-marfil md:px-16">
  <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
    <div data-reveal class="flex flex-col gap-8">
      <div class="flex flex-col gap-4">
        <p class="caption-3 text-oro">Visítanos</p>
        <h2 id="visitanos-titulo" class="heading-2">Te esperamos en el Centro Cívico</h2>
        <p class="body-3 max-w-170 text-marfil/80">{negocio.invitacion}</p>
      </div>

      <dl class="grid gap-6 sm:grid-cols-2">
        {
          datos.map(({ icono: Icono, titulo, texto }) => (
            <div class="flex gap-3">
              <Icono class="mt-0.5 size-5 shrink-0 text-oro" aria-hidden="true" />
              <div class="flex flex-col gap-1">
                <dt class="caption-3 text-marfil/70">{titulo}</dt>
                <dd class="body-3">{texto}</dd>
              </div>
            </div>
          ))
        }
      </dl>

      <div class="flex flex-wrap items-center gap-4">
        <BotonReservar tono="marfil" />
        <a
          href={negocio.mapsUrl}
          target="_blank"
          rel="noopener"
          class="button-md inline-flex items-center gap-2 rounded-full border border-marfil/30 px-3 py-2 transition-colors duration-300 ease-savia hover:bg-marfil/10 active:scale-98"
        >
          <MapPinIcon class="size-5" aria-hidden="true" />
          Cómo llegar
        </a>
        <a
          href={negocio.instagramUrl}
          target="_blank"
          rel="noopener"
          class="button-md inline-flex items-center gap-2 rounded-full px-3 py-2 transition-colors duration-300 ease-savia hover:bg-marfil/10 active:scale-98"
        >
          <InstagramIcon class="size-5" aria-hidden="true" />
          Instagram
        </a>
      </div>
    </div>

    <Picture
      data-reveal
      src={clienta}
      alt="Clienta fotografiando el letrero iluminado de Savia Lounge"
      widths={[480, 720, 1000]}
      sizes="(min-width: 768px) 50vw, 100vw"
      formats={["avif", "webp"]}
      class="aspect-4/5 w-full rounded-3xl object-cover"
    />
  </div>
</section>
