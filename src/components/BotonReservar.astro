---
import WhatsappIcon from "@phosphor-icons/core/assets/regular/whatsapp-logo.svg";
import { negocio } from "../data/site";

interface Props {
  /** "bosque" sobre fondos claros, "marfil" sobre fondos oscuros. */
  tono?: "bosque" | "marfil";
  tamano?: "md" | "sm";
  texto?: string;
  class?: string;
}

const { tono = "bosque", tamano = "md", texto = "Reservar por WhatsApp", class: className = "" } = Astro.props;
---

<a
  href={negocio.whatsappUrl}
  target="_blank"
  rel="noopener"
  class:list={[
    "inline-flex items-center gap-2 rounded-full transition-[background-color,transform] duration-300 ease-savia hover:-translate-y-0.5 active:translate-y-0 active:scale-98",
    tamano === "md" ? "button-md px-3 py-2" : "button-sm px-3 py-2",
    tono === "bosque" ? "bg-bosque text-marfil hover:bg-musgo" : "bg-marfil text-bosque hover:bg-lino",
    className,
  ]}
>
  <WhatsappIcon class={tamano === "md" ? "size-5" : "size-4"} aria-hidden="true" />
  <span>{texto}</span>
</a>
