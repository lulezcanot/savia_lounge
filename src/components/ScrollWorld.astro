---
import { getImage } from "astro:assets";
import MapPinIcon from "@phosphor-icons/core/assets/regular/map-pin.svg";
import ArrowDownIcon from "@phosphor-icons/core/assets/regular/arrow-down.svg";
import BotonReservar from "./BotonReservar.astro";
import Pendiente from "./Pendiente.astro";
import { negocio, paradas, recorrido } from "../data/site";
import posterImg from "../assets/photos/recorrido-poster.jpg";

const poster = await getImage({ src: posterImg, width: 1280, format: "webp" });
const [hero, ...resto] = paradas;
// Altura de cada parada proporcional a la duración de su clip (mínimo una pantalla).
// La última termina cuando su borde inferior llega abajo, así que necesita una pantalla más.
const alto = (d: number, ultima = false) =>
  `min-height: ${(Math.max(1, d * recorrido.pantallasPorSegundo) + (ultima ? 1 : 0)) * 100}svh`;
---

<section
  id="recorrido"
  aria-label="Recorrido por Savia Lounge"
  data-scroll-world
  data-paso={JSON.stringify(recorrido.paso)}
  class="relative grid grid-cols-1"
>
  <!-- Capa de fondo: queda fija mientras se recorre la sección. -->
  <div class="sticky top-0 col-start-1 row-start-1 h-svh self-start overflow-hidden bg-tinta">
    {
      paradas.map((p, i) => (
        <video
          data-sw-clip
          data-duracion={p.duracion}
          aria-hidden="true"
          muted
          playsinline
          preload={i < 2 ? "auto" : "metadata"}
          disablepictureinpicture
          poster={i === 0 ? poster.src : undefined}
          class="absolute inset-0 size-full object-cover"
          style={i === 0 ? undefined : "opacity: 0"}
        >
          <source src={`${p.clip}.mp4`} type="video/mp4" />
        </video>
      ))
    }
    <div aria-hidden="true" class="absolute inset-0 bg-tinta/20"></div>

    <!-- Riel: cada parada es un botón; queda por encima de las tarjetas. -->
    <nav aria-label="Paradas del recorrido" class="absolute top-1/2 right-6 z-10 hidden w-56 -translate-y-1/2 lg:block">
      <ol class="flex flex-col items-stretch gap-3">
        {
          paradas.map((p, i) => (
            <li>
              <button
                type="button"
                data-sw-dot
                data-lugar={p.lugar}
                class="title-5 flex w-full cursor-pointer items-center justify-between gap-3 rounded-full border border-marfil/60 bg-tinta/40 px-4 py-1.5 text-marfil/80 backdrop-blur-sm transition-colors duration-500 ease-savia hover:border-marfil hover:text-marfil data-active:border-marfil data-active:bg-tinta/60 data-active:text-marfil"
              >
                <span>{p.lugar}</span>
                <span class="font-display text-base text-oro">{String(i + 1).padStart(2, "0")}</span>
              </button>
            </li>
          ))
        }
      </ol>
      <button
        type="button"
        data-sw-next
        class="button-sm mt-6 ml-auto flex cursor-pointer items-center gap-2 rounded-full bg-marfil/90 px-3 py-2 text-tinta transition-colors duration-300 ease-savia hover:bg-marfil active:scale-98"
      >
        <span data-sw-next-label>Siguiente: {paradas[1].lugar}</span>
        <ArrowDownIcon class="size-4" aria-hidden="true" />
      </button>
    </nav>
    <p class="caption-4 absolute right-4 bottom-4 rounded-full bg-tinta/50 px-3 py-1 text-marfil md:right-6">
      {recorrido.aviso}
    </p>
  </div>

  <!-- Capa de texto: una parada por clip. -->
  <div class="col-start-1 row-start-1">
    <article data-sw-stop style={alto(hero.duracion)}>
      <div class="sticky top-0 flex min-h-svh items-end px-4 pt-24 pb-16 md:items-center md:px-16 md:pb-0">
        <!-- En móvil la portada se queda en la línea de servicios, el titular y el botón. -->
        <!-- Portada: eslogan, reserva, dirección y la invitación a deslizar, todo centrado. -->
        <div class="flex max-w-150 flex-col items-center gap-5 rounded-3xl bg-marfil/95 p-6 text-center md:gap-6 md:px-12 md:py-10">
          <h1 class="heading-3 bg-linear-to-r from-tinta to-tinta-suave bg-clip-text pb-1 text-transparent md:heading-1">
            Pequeños rituales<br class="hidden md:inline" /> que nutren tu belleza
          </h1>
          <BotonReservar />
          <p class="caption-2 hidden items-start justify-center gap-2 text-tinta-suave md:flex">
            <MapPinIcon class="mt-0.5 size-4 shrink-0 text-musgo" aria-hidden="true" />
            <span>{negocio.direccionCorta}, {negocio.zona}, {negocio.ciudad} · {negocio.horarioCorto}</span>
          </p>
          <p class="caption-4 hidden items-center justify-center gap-2 text-tinta-suave md:flex">
            <ArrowDownIcon class="size-4" aria-hidden="true" />
            Desliza para recorrer el salón
          </p>
        </div>
      </div>
    </article>

    {
      resto.map((p, i) => (
        <article data-sw-stop id={`parada-${p.id}`} style={alto(p.duracion, i === resto.length - 1)}>
          <div
            class:list={[
              "sticky top-0 flex min-h-svh items-end px-4 pt-24 pb-16 md:px-16",
              // En el cierre, la tarjeta baja para no tapar el logo del render.
              p.reservar ? "md:pb-16" : "md:items-center md:pb-0",
            ]}
          >
            <div data-reveal class="flex max-w-xl flex-col gap-2 rounded-3xl bg-marfil/95 p-5 md:gap-4 md:p-8">
              <div class="flex items-end gap-4">
                <span class="numeral" aria-hidden="true">{String(i + 2).padStart(2, "0")}</span>
                <p class="caption-3 pb-2 text-musgo">{p.lugar}</p>
              </div>
              <h2 class="heading-4 text-tinta md:heading-3">{p.titulo}</h2>
              {/* En móvil la tarjeta se queda en número, lugar y título para que se vea el paseo. */}
              <div class="hidden flex-col gap-4 md:flex">
                <p class="body-3 text-tinta-suave">{p.texto}</p>
                {p.detalle && (
                  <p class="title-4 flex items-center gap-3 text-tinta">
                    <span class="h-px w-8 bg-oro" aria-hidden="true" />
                    {p.detalle}
                  </p>
                )}
                {p.pendiente && <Pendiente texto={p.pendiente} class="text-tinta-suave" />}
                {p.reservar && <BotonReservar class="w-fit" />}
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { interceptarGestos, lenis, reducido } from "../scripts/scroll";

  const seccion = document.querySelector<HTMLElement>("[data-scroll-world]");

  if (seccion) {
    const paradas = [...seccion.querySelectorAll<HTMLElement>("[data-sw-stop]")];
    const puntos = [...seccion.querySelectorAll<HTMLElement>("[data-sw-dot]")];
    const clips = [...seccion.querySelectorAll<HTMLVideoElement>("[data-sw-clip]")];
    const ultima = paradas.length - 1;
    const duracion = (v: HTMLVideoElement) =>
      Number.isFinite(v.duration) && v.duration > 0 ? v.duration : Number(v.dataset.duracion);

    // Cada parada es el tramo de su clip: empieza cuando su borde superior llega arriba.
    const tramos = paradas.map((p, i) =>
      ScrollTrigger.create({ trigger: p, start: "top top", end: i === ultima ? "bottom bottom" : "bottom top" }),
    );

    let activa = -1;
    let objetivo = 0;


    function activar(i: number) {
      if (i === activa) return;
      activa = i;
      // Los clips se cortaron en pausas y son continuos: el cambio es directo, sin fundido.
      clips.forEach((c, j) => (c.style.opacity = j === i ? "1" : "0"));
      puntos.forEach((p, j) => p.toggleAttribute("data-active", j === i));
      // Carga el clip activo (por si se llegó de un salto) y pide el siguiente antes de llegar a él.
      for (const clip of [clips[i], clips[i + 1]]) {
        if (clip && clip.preload !== "auto") {
          clip.preload = "auto";
          clip.load();
        }
      }

      if (clips[i].readyState >= 1) clips[i].currentTime = objetivo;
    }

    function actualizar(y: number) {
      let i = 0;
      tramos.forEach((t, j) => {
        if (y >= t.start) i = j;
      });
      const { start, end } = tramos[i];
      const progreso = Math.min(Math.max((y - start) / Math.max(end - start, 1), 0), 1);
      objetivo = reducido ? 0 : progreso * (duracion(clips[i]) - 0.05);
      activar(i);
    }

    ScrollTrigger.create({
      trigger: seccion,
      start: "top bottom",
      end: "bottom top",
      onUpdate: (self) => actualizar(self.scroll()),
      onRefresh: (self) => actualizar(self.scroll()),
    });
    actualizar(window.scrollY);

    // Safari en iOS necesita un play/pause para permitir mover currentTime.
    clips.forEach((c) =>
      c.addEventListener("loadedmetadata", () => c.play().then(() => c.pause()).catch(() => {}), { once: true }),
    );

    if (!reducido) {
      // El vídeo va directo a la posición del scroll: Lenis ya pone la suavidad, y un
      // segundo suavizado aquí se notaba como retraso. Si el navegador aún está buscando
      // el cuadro anterior, no se encadena otro salto: se reintenta al terminar (seeked).
      const buscar = () => {
        const clip = clips[activa];
        if (!clip || clip.readyState < 2 || clip.seeking) return;
        if (Math.abs(clip.currentTime - objetivo) > 1 / 60) clip.currentTime = objetivo;
      };
      gsap.ticker.add(buscar);
      clips.forEach((c) => c.addEventListener("seeked", buscar));
    }

    // ── Paseo por pasos ──────────────────────────────────────────────────────────
    // Un gesto (rueda, deslizar o tecla) lleva de una parada a la siguiente y el clip
    // se reproduce solo durante el trayecto. Cada parada descansa en el primer cuadro
    // de su clip, que coincide con una pausa del render; la última, en el logo.
    const paso = JSON.parse(seccion.dataset.paso!) as { velocidad: number; minimo: number; maximo: number };
    const lugares = puntos.map((p) => p.dataset.lugar!);
    const siguiente = seccion.querySelector<HTMLButtonElement>("[data-sw-next]");
    const etiquetaSiguiente = seccion.querySelector<HTMLElement>("[data-sw-next-label]");
    const MARGEN = 4;

    const descansos = () => [...tramos.slice(0, ultima).map((t) => t.start), tramos[ultima].end];
    // Donde termina la sección: más abajo ya no se ve el paseo.
    const salida = () => tramos[ultima].end + window.innerHeight;
    // Segundos de vídeo acumulados hasta una posición de scroll.
    const tiempoEn = (y: number) =>
      tramos.reduce(
        (s, t, i) => s + Math.min(Math.max((y - t.start) / Math.max(t.end - t.start, 1), 0), 1) * duracion(clips[i]),
        0,
      );

    let animando = false;
    let finAnimacion = 0;

    /** Parada a la que lleva un gesto en esa dirección, o null si el gesto es scroll normal. */
    function destino(dir: number): number | null {
      const y = window.scrollY;
      const d = descansos();
      const fin = d[ultima];
      // Debajo del paseo: al subir se vuelve a enganchar en el logo mientras aún se ve.
      if (y > fin + MARGEN) return dir < 0 && y < salida() - MARGEN ? fin : null;
      if (dir > 0) return d.find((r) => r > y + MARGEN) ?? null;
      return d.findLast((r) => r < y - MARGEN) ?? null;
    }

    function ir(y: number) {
      if (!lenis) {
        window.scrollTo(0, y);
        return;
      }
      // La duración sale de los segundos de vídeo del trayecto: el render va siempre a
      // un ritmo parecido, con arranque y frenada suaves como las pausas de la cámara.
      const segundos = Math.abs(tiempoEn(y) - tiempoEn(window.scrollY));
      const duration = Math.min(Math.max(segundos / paso.velocidad, paso.minimo), paso.maximo);
      animando = true;
      lenis.scrollTo(y, {
        duration,
        easing: (t) => -(Math.cos(Math.PI * t) - 1) / 2,
        lock: true,
        force: true,
        onComplete: () => {
          animando = false;
          finAnimacion = performance.now();
        },
      });
    }

    function evitar(e: Event) {
      if (e.cancelable) e.preventDefault();
    }

    if (lenis) {
      let ultimoEvento = 0;
      // Un toque decide al primer movimiento si es del paseo o scroll normal, y lo mantiene.
      let toque: "paseo" | "normal" | null = null;

      interceptarGestos(({ deltaY, event }) => {
        const ahora = performance.now();
        const pausa = ahora - ultimoEvento;
        ultimoEvento = ahora;

        if (event.type === "touchstart") {
          toque = null;
          return true;
        }
        if (event.type === "touchend") return toque !== "paseo";
        if (event.type === "touchmove" && toque) {
          if (toque === "paseo") evitar(event);
          return toque === "normal";
        }
        if (!deltaY) return true;

        const dir = Math.sign(deltaY);
        if (animando) {
          if (event.type === "touchmove") toque = "paseo";
          evitar(event);
          return false;
        }
        const y = destino(dir);
        if (y === null) {
          if (event.type === "touchmove") toque = "normal";
          return true;
        }
        evitar(event);
        if (event.type === "touchmove") {
          toque = "paseo";
          ir(y);
          return false;
        }
        // Rueda: el trackpad sigue mandando eventos por inercia después de un paso.
        // Solo cuenta como gesto nuevo tras una pausa, o cuando la inercia ya se apagó.
        if (pausa > 200 || (ahora - finAnimacion > 700 && Math.abs(deltaY) > 12)) ir(y);
        return false;
      });

      window.addEventListener("keydown", (e) => {
        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || lenis?.isStopped) return;
        const objetivoTecla = e.target as HTMLElement;
        if (objetivoTecla.closest("input, textarea, select, [contenteditable]")) return;
        // La barra espaciadora sobre un botón o enlace lo activa: no se toca.
        if (e.key === " " && objetivoTecla.closest("button, a, summary, [role='tab']")) return;
        const dir =
          e.key === "ArrowDown" || e.key === "PageDown" || (e.key === " " && !e.shiftKey)
            ? 1
            : e.key === "ArrowUp" || e.key === "PageUp" || (e.key === " " && e.shiftKey)
              ? -1
              : 0;
        if (!dir) return;
        const y = destino(dir);
        if (y === null) return;
        e.preventDefault();
        if (!animando) ir(y);
      });
    }

    puntos.forEach((p, i) => p.addEventListener("click", () => !animando && ir(descansos()[i])));
    siguiente?.addEventListener("click", () => {
      if (!animando) ir(activa < ultima ? descansos()[activa + 1] : salida());
    });

    // El botón dice a dónde lleva.
    const rotular = () => {
      if (etiquetaSiguiente)
        etiquetaSiguiente.textContent = activa < ultima ? `Siguiente: ${lugares[activa + 1]}` : "Seguir bajando";
      puntos.forEach((p, j) => (j === activa ? p.setAttribute("aria-current", "step") : p.removeAttribute("aria-current")));
    };
    ScrollTrigger.create({ trigger: seccion, start: "top bottom", end: "bottom top", onUpdate: rotular });
    rotular();
  }
</script>
