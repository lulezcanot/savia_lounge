---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ScrollWorld from "../components/ScrollWorld.astro";
import TaglineReveal from "../components/TaglineReveal.astro";
import Carta from "../components/Carta.astro";
import Trabajos from "../components/Trabajos.astro";
import Reservar from "../components/Reservar.astro";
import Faq from "../components/Faq.astro";
import Visitanos from "../components/Visitanos.astro";
import Footer from "../components/Footer.astro";
import DescuentoModal from "../components/DescuentoModal.astro";
---

<Layout>
  <Header />
  <main id="contenido">
    <ScrollWorld />
    <TaglineReveal />
    <Carta />
    <Trabajos />
    <Reservar />
    <Faq />
    <Visitanos />
  </main>
  <Footer />
  <DescuentoModal />
</Layout>
